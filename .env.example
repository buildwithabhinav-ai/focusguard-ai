SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql://username:password@host:5432/database

EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-email-password

GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
DEFAULT_LLM=groq

SARVAM_API_KEY=your-sarvam-api-key

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# E-mail (invitations). For Gmail: enable 2-Step Verification, create an App Password and use it below.
# SMTP_SECURITY = starttls (587, default) | ssl (465) | none (local test server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls

# Public address of the web app; used to build the link inside invitation e-mails.
FRONTEND_URL=http://localhost:5173

# Support / contact address shown in e-mails and error messages.
SUPPORT_EMAIL=support.focusguardai@gmail.com
